# ─── Required ────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather.
TELEGRAM_TOKEN=

# REQUIRED. Numeric chat IDs allowed to control this bot, comma-separated.
# Message @userinfobot on Telegram to get yours.
#
# The bot REFUSES TO START without this. Any Telegram user can message a bot
# they know the @username of — without an allowlist, a stranger could add
# liquidity from your wallet, remove it, or start Extreme Mode. There is no
# "allow everyone" mode, by design.
TELEGRAM_OWNER_IDS=

# ─── Wallets ─────────────────────────────────────────────────────────────────
# Base58 private keys. Loaded automatically on startup. Added here by the bot
# when you import a wallet via Telegram. Keep this file at chmod 600.
# WALLET_1=
# WALLET_2=

# ─── RPC ─────────────────────────────────────────────────────────────────────
# Comma-separated `label=url` pairs, tried fastest-first with automatic
# failover. {HELIUS_API_KEY} is interpolated from the variable below, so the
# key never has to be embedded in a committed URL.
#
# If unset, defaults to Helius (when HELIUS_API_KEY is present) + public mainnet.
RPC_ENDPOINTS=helius=https://mainnet.helius-rpc.com/?api-key={HELIUS_API_KEY},helius-pump=https://pump.helius-rpc.com/,solana-public=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=

# RPC_COMMITMENT=confirmed          # processed | confirmed | finalized
# RPC_TIMEOUT_MS=15000
# RPC_MAX_RETRIES=3
# RPC_HEALTH_INTERVAL_MS=60000      # re-score endpoints and fail over

# ─── Transactions ────────────────────────────────────────────────────────────
# Priority fee in micro-lamports per compute unit. The v1 bot sent NONE, so its
# transactions competed for blockspace at zero priority and landed late or not
# at all under load. Raise this when the network is congested.
TX_PRIORITY_FEE_MICROLAMPORTS=50000
# TX_COMPUTE_UNIT_LIMIT=400000
# TX_MAX_ACTIVE_BIN_SLIPPAGE=5      # bins of drift tolerated between build and land
# TX_CONFIRM_TIMEOUT_MS=45000
# TX_MAX_SEND_ATTEMPTS=3

# ─── Extreme Mode ────────────────────────────────────────────────────────────
# Rebalancing is driven by websocket pushes on the pool's LbPair account.
# EXTREME_POLL_INTERVAL_MS is only the fallback for when the socket is quiet.
# EXTREME_POLL_INTERVAL_MS=2500
#
# Floor between two strategy evaluations. Defaults to 2500ms, which reproduces
# the v1 bot's cadence exactly. Set to 0 to let the websocket drive rebalances
# at slot latency — FASTER, but it changes how often you trade.
# EXTREME_MIN_EVAL_INTERVAL_MS=2500
#
# Circuit breakers. v1 had none: it looped forever, paying fees every cycle.
# EXTREME_MAX_CYCLES=0              # 0 = unlimited
# EXTREME_MIN_SOL_BALANCE=0.01      # halt below this balance
# EXTREME_SETTLE_DELAY_MS=3000
# EXTREME_TOKEN_BALANCE_TIMEOUT_MS=10000

# ─── Wallet sizing ───────────────────────────────────────────────────────────
# SOL held back from `max` / percentage sizing to cover fees and rent.
# WALLET_FEE_RESERVE_SOL=0.08

# ─── Storage ─────────────────────────────────────────────────────────────────
# DATA_FILE=./data.json
# ENV_FILE=./.env
# STATE_FLUSH_INTERVAL_MS=250       # coalesce writes

# ─── Networking ──────────────────────────────────────────────────────────────
# HTTP_POOL_CONNECTIONS=16
# HTTP_TIMEOUT_MS=15000
# HTTP_MAX_RETRIES=3

# ─── Observability ───────────────────────────────────────────────────────────
# LOG_LEVEL=info                    # trace | debug | info | warn | error
# LOG_FORMAT=pretty                 # pretty (dev) | json (prod); defaults to json when NODE_ENV=production
# METRICS_INTERVAL_MS=60000         # 0 disables periodic metrics logging
